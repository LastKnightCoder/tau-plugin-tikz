      }
    },
    "android": {
      "minAppVersion": "0.2.3",
      "required": [
        "sourceEditor"
      ],
      "optional": [],
      "elements": {
        "tikz": "edit"
      }
    },
    "ios": {
      "minAppVersion": "0.2.3",
      "required": [
        "sourceEditor"
      ],
      "optional": [],
      "elements": {
        "tikz": "edit"
      }
    }
  }
}
